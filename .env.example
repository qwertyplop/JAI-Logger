# Upstash Redis REST credentials. Vercel KV uses the KV_* names automatically.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Or plain Upstash names:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: override the built-in SHA-256 hash of the six-word admin phrase.
ADMIN_SECRET_HASH=

# Optional: public origin used in generated links, e.g. https://your-app.vercel.app
PUBLIC_ORIGIN=
