{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/admin/:path*",
      "destination": "/api/admin"
    },
    {
      "source": "/api/session/:path*",
      "destination": "/api/session"
    },
    {
      "source": "/api/logs/:path*",
      "destination": "/api/logs"
    },
    {
      "source": "/api/ai-debug/:path*",
      "destination": "/api/ai-debug"
    },
    {
      "source": "/assets/:path*",
      "destination": "/frontend/dist/assets/:path*"
    },
    {
      "source": "/favicon.svg",
      "destination": "/frontend/dist/favicon.svg"
    },
    {
      "source": "/opengraph.jpg",
      "destination": "/frontend/dist/opengraph.jpg"
    },
    {
      "source": "/admin",
      "destination": "/frontend/dist/index.html"
    },
    {
      "source": "/admin/",
      "destination": "/frontend/dist/index.html"
    },
    {
      "source": "/",
      "destination": "/frontend/dist/index.html"
    }
  ]
}
